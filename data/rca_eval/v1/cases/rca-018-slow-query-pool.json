    {
      "id": "runbook-rca-018",
      "source_type": "runbook",
      "timestamp": null,
      "content": "Slow queries that hold connections will exhaust the connection pool under load. Run EXPLAIN on the slow query and add indexes where full-table scans are detected. Connection pool exhaustion is a downstream symptom of the slow query, not an independent cause.",
      "data": {
        "document_title": "Slow Query and Connection Pool Runbook"
      }
    }
  ],
  "expectations": {
