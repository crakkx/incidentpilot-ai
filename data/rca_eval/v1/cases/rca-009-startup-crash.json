    {
      "id": "runbook-rca-009",
      "source_type": "runbook",
      "timestamp": null,
      "content": "Startup crashes with NullPointerException may indicate a race condition where a request arrives before async initialization completes. Add a readiness gate or use liveness probe startupFailureThreshold to delay traffic routing until fully initialized.",
