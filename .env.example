APP_NAME=IncidentPilot AI
APP_VERSION=0.9.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://incidentpilot:incidentpilot@localhost:5432/incidentpilot
TEST_DATABASE_URL=postgresql+psycopg://incidentpilot:incidentpilot@localhost:5432/incidentpilot_test
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

LLM_PROVIDER=mistral

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/cache/sentence-transformers

MISTRAL_API_KEY=YOUR_API_KEY_HERE
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=240
MISTRAL_TEMPERATURE=0.0
MISTRAL_MAX_TOKENS=1800
MISTRAL_RANDOM_SEED=42

TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

RCA_MAX_LOGS=50
RCA_MAX_METRICS=50
RCA_MAX_DEPLOYMENTS=20
RCA_RUNBOOK_TOP_K=5

# "graph" (LangGraph multi-node pipeline) or "single_call" (legacy prompt)
RCA_PIPELINE_MODE=graph
RCA_GRAPH_MAX_REPAIRS=3

# Auth — generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Seed accounts created by `python -m scripts.seed_users` (docker-compose runs
# this automatically). Change these before deploying anywhere shared.
SEED_ADMIN_EMAIL=admin@incidentpilot.example
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_OPERATOR_EMAIL=operator@incidentpilot.example
SEED_OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
SEED_VIEWER_EMAIL=viewer@incidentpilot.example
SEED_VIEWER_PASSWORD=CHANGE_ME_VIEWER_PASSWORD

# Comma-separated list of origins the frontend is served from
CORS_ALLOW_ORIGINS=http://localhost:3000
